{
  "name": "ssnnews-root",
  "version": "1.0.0",
  "description": "SSN News - Mobile-friendly news web application",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "start": "concurrently \"npm run server:start\" \"npm run client:start\"",
    "build": "npm run client:build",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "server:dev": "cd server && npm run dev",
    "server:start": "cd server && npm start",
    "client:dev": "cd client && npm start",
    "client:start": "cd client && npm run serve",
    "client:build": "cd client && npm run build",
    "test": "concurrently \"npm run server:test\" \"npm run client:test\"",
    "server:test": "cd server && npm test",
    "client:test": "cd client && npm test",
    "lint": "concurrently \"npm run server:lint\" \"npm run client:lint\"",
    "server:lint": "cd server && eslint .",
    "client:lint": "cd client && eslint src/",
    "deploy": "npm run build && npm run deploy:server",
    "deploy:server": "cd server && npm run deploy",
    "clean": "rm -rf node_modules server/node_modules client/node_modules client/build",
    "setup": "npm run install:all && cp .env.example .env && cp server/.env.example server/.env && cp client/.env.example client/.env"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "news",
    "mobile-app",
    "react",
    "nodejs",
    "mongodb",
    "gujarat-news",
    "local-news"
  ],
  "author": "SSN News Team",
  "license": "MIT"
}
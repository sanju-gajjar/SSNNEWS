# === SSN NEWS API CONFIGURATION ===

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ssnnews?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Server Configuration
PORT=8080
NODE_ENV=production

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com,https://ssnnews.onrender.com

# === EXTERNAL API KEYS ===

# Weather API (OpenWeatherMap)
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=1ea8c31073c10de609b8b57dd4ed7faa

# Horoscope API (Aztro - No key needed)
# Free service: https://aztro.sameerkumar.website/

# Gold & Silver Rates API (GoldAPI.io)
# Get your free API key at: https://www.goldapi.io/
GOLDAPI_KEY=goldapi-hoaacsmgxwbhqi-io

# Sports API (CricAPI or RapidAPI)
# Get your API key at: https://www.cricapi.com/ or https://rapidapi.com/
CRICAPI_KEY=your_cricapi_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube API (YouTube Data API v3)
# Get your API key at: https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Fuel Price API (Custom scraping endpoints)
FUEL_API_KEY=your_fuel_api_key_here

# MongoDB Connection URL - Replace with your actual MongoDB connection string
# For local development: mongodb://localhost:27017/ssnnews
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ssnnews
MONGODB_URL=mongodb://localhost:27017/ssnnews

# Server Port (default: 8080)
PORT=8080

# News API Key for external news fetching
# Get your API key from https://newsdata.io/
# This is required for fetching external news articles
NEWS_API_KEY=your_newsdata_io_api_key_here

# ======================
# CLIENT ENVIRONMENT VARIABLES
# ======================

# Backend API URL - Update this based on your deployment
# For local development: http://swadeshsandeshnews.com
# For production: https://your-backend-domain.com
REACT_APP_API_URL=http://swadeshsandeshnews.com

# ======================
# SETUP INSTRUCTIONS
# ======================
# 1. Copy this file to .env in the root directory
# 2. Copy server/.env.example to server/.env (if server has separate env)
# 3. Copy client/.env.example to client/.env (if client has separate env)
# 4. Update all placeholder values with your actual configuration
# 5. Never commit .env files to version control for security

# ======================
# REQUIRED SERVICES
# ======================
# 1. MongoDB database (local or cloud)
# 2. NewsData.io API account for external news
# 3. Generate a strong JWT secret key
# Example Environment Variables for SSNNEWS Project
# Copy this file to .env and update the values

# ======================
# SERVER ENVIRONMENT VARIABLES
# ======================

# JWT Secret for token signing - IMPORTANT: Change this to a strong, unique secret key
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# MongoDB Connection URL - Replace with your actual MongoDB connection string
# For local development: mongodb://localhost:27017/ssnnews
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ssnnews
MONGODB_URL=mongodb://localhost:27017/ssnnews

# Server Port (default: 8080)
PORT=8080

# News API Key for external news fetching
# Get your API key from https://newsdata.io/
# This is required for fetching external news articles
NEWS_API_KEY=your_newsdata_io_api_key_here

# ======================
# CLIENT ENVIRONMENT VARIABLES
# ======================

# Backend API URL - Update this based on your deployment
# For local development: https://ssnnewsserver.onrender.com
# For production: https://your-backend-domain.com
REACT_APP_API_URL=https://ssnnewsserver.onrender.com

# ======================
# SETUP INSTRUCTIONS
# ======================
# 1. Copy this file to .env in the root directory
# 2. Copy server/.env.example to server/.env (if server has separate env)
# 3. Copy client/.env.example to client/.env (if client has separate env)
# 4. Update all placeholder values with your actual configuration
# 5. Never commit .env files to version control for security

# ======================
# REQUIRED SERVICES
# ======================
# 1. MongoDB database (local or cloud)
# 2. NewsData.io API account for external news
# 3. Generate a strong JWT secret key